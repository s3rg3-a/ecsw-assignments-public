// ChaCha20 Implementation Template
// Complete the TODOs below to implement ChaCha20

// Performs: a += b; d ^= a; d <<<= 16
//           c += d; b ^= c; b <<<= 12
//           a += b; d ^= a; d <<<= 8
//           c += d; b ^= c; b <<<= 7
inline fn quarterround(reg u32 a, reg u32 b, reg u32 c, reg u32 d)
    -> reg u32, reg u32, reg u32, reg u32 {
        a += b; d ^= a; d <<r= 16;
        c += d; b ^= c; b <<r= 12;
        a += b; d ^= a; d <<r= 8;
        c += d; b ^= c; b <<r= 7;
    return a, b, c, d;
}

// Column round: applies quarterround to all 4 columns
// Column 0: (0, 4, 8, 12)
// Column 1: (1, 5, 9, 13)
// Column 2: (2, 6, 10, 14)
// Column 3: (3, 7, 11, 15)
inline fn column_round(reg ptr u32[16] pstate) -> reg ptr u32[16] {
    reg u32 a, b, c, d;
    inline int i;
    for i = 0 to 4 {
        a = pstate[i];
        b = pstate[i + 4];
        c = pstate[i + 8];
        d = pstate[i + 12];
        a, b, c, d = quarterround(a, b, c, d);
        pstate[i] = a;
        pstate[i + 4] = b;
        pstate[i + 8] = c;
        pstate[i + 12] = d;
    }
    return pstate;
}

// Performs quarterrounds on the specified indices
// Used for diagonal_round
inline fn diagonal_helper(reg ptr u32[16] pstate, inline int index_a, inline int index_b, inline int index_c, inline int index_d) -> reg ptr u32[16]{
    reg u32 a, b, c, d;
    a = pstate[index_a];
    b = pstate[index_b];
    c = pstate[index_c];
    d = pstate[index_d];
    a, b, c, d = quarterround(a, b, c, d);
    pstate[index_a] = a;
    pstate[index_b] = b;
    pstate[index_c] = c;
    pstate[index_d] = d;
    return pstate;
}

// Diagonal round: applies quarterround to all 4 diagonals
// Diagonal 0: (0, 5, 10, 15)
// Diagonal 1: (1, 6, 11, 12)
// Diagonal 2: (2, 7, 8, 13)
// Diagonal 3: (3, 4, 9, 14)
inline fn diagonal_round(reg ptr u32[16] pstate) -> reg ptr u32[16] {
    // reg u32 a, b, c, d; never used?
    // inline int i; never used?
    pstate = diagonal_helper(pstate, 0, 5, 10, 15);
    pstate = diagonal_helper(pstate, 1, 6, 11, 12);
    pstate = diagonal_helper(pstate, 2, 7, 8, 13);
    pstate = diagonal_helper(pstate, 3, 4, 9, 14);
    return pstate;
}

// Double round: 4 column quarterrounds and 4 diagonal ones
// Rows a (x0,x1,x2,x3), b (x4,x5,x6,x7) and d (x12,x13,x14,x15) stay in registers.
// Row c (x8,x9,x10,x11) lives on stack in c[0..3]. Only one c word in register at a time. 
// Register use inside: 12 state words+1 temporary = 13 (might want to try 14 later).
inline fn double_round(reg u32 x0, reg u32 x1, reg u32 x2, reg u32 x3, reg u32 x4, reg u32 x5,
    reg u32 x6, reg u32 x7, reg u32 x12, reg u32 x13, reg u32 x14, reg u32 x15, stack u32[4] c)
    -> reg u32, reg u32, reg u32, reg u32 , reg u32 , reg u32 , reg u32 , reg u32
    , reg u32 , reg u32 , reg u32 , reg u32, stack u32[4] {

    reg u32 t;
    // Column round 
    t = c[0]; x0,x4,t,x12 = quarterround(x0,x4,t,x12); c[0] = t; //(0,4,8,12)
    t = c[1]; x1,x5,t,x13 = quarterround(x1,x5,t,x13); c[1] = t; //(1,5,9,13)
    t = c[2]; x2,x6,t,x14 = quarterround(x2,x6,t,x14); c[2] = t; //(2,6,10,14)
    t = c[3]; x3,x7,t,x15 = quarterround(x3,x7,t,x15); c[3] = t; //(3,7,11,15)

    // Diagonal round 
    t = c[2]; x0,x5,t,x15 = quarterround(x0,x5,t,x15); c[2] = t; //(0,5,10,15)
    t = c[3]; x1,x6,t,x12 = quarterround(x1,x6,t,x12); c[3] = t; //(1,6,11,12)
    t = c[0]; x2,x7,t,x13 = quarterround(x2,x7,t,x13); c[0] = t; //(2,7,8,13)
    t = c[1]; x3,x4,t,x14 = quarterround(x3,x4,t,x14); c[1] = t; //(3,4,9,14)

    return x0,x1,x2,x3,x4,x5,x6,x7,x12,x13,x14,x15,c;

    }


fn chacha20_block(reg ptr u8[64] output_ptr, reg ptr u32[16] input_ptr) -> reg ptr u8[64]{
    stack u32[16] ws;
    stack u32[4] c;
    reg u32 x0,x1,x2,x3,x4,x5,x6,x7,x12,x13,x14,x15;
    reg u32 t, y;
    inline int i;

    () = #spill(output_ptr);

    for i = 0 to 4 {     //Row c to stack
        t = input_ptr[8+i];
        c[i] = t;
    }

    x0 = input_ptr[0]; x1 = input_ptr[1]; x2 = input_ptr[2]; x3 = input_ptr[3];
    x4 = input_ptr[4]; x5 = input_ptr[5]; x6 = input_ptr[6]; x7 = input_ptr[7];
    x12 = input_ptr[12]; x13 = input_ptr[13]; x14 = input_ptr[14]; x15 = input_ptr[15];

    () = #spill(input_ptr);

    // 20 rounds (10 double rounds)
    for i = 0 to 10 {
        x0,x1,x2,x3,x4,x5,x6,x7,x12,x13,x14,x15,c = double_round(x0,x1,x2,x3,x4,x5,x6,x7,x12,x13,x14,x15,c);
    }

    ws[0] = x0; ws[1] = x1; ws[2] = x2; ws[3] = x3;
    ws[4] = x4; ws[5] = x5; ws[6] = x6; ws[7] = x7;
    for i = 0 to 4 {
        t = c[i];
        ws[8+i] = t;
    }
    ws[12] = x12; ws[13] = x13; ws[14] = x14; ws[15] = x15;

    () = #unspill(input_ptr, output_ptr);

    // Add the state and working_state
    // state <- state + working_state
    for i = 0 to 16 {
        t = ws[i];
        y = input_ptr[i];
        t += y;
        output_ptr[:u32 i] = t;
    }

    return output_ptr;
}

fn chacha20_keysetup(reg ptr u32[16] state_ptr, reg ptr u8[32] sk_ptr) -> reg ptr u32[16]{
    reg u32 constant, word;
    inline int i;

    // Words 0-3 are fixed constants
    constant = 0x61707865;
    state_ptr[0] = constant;
    constant = 0x3320646e;
    state_ptr[1] = constant;
    constant = 0x79622d32;
    state_ptr[2] = constant;
    constant = 0x6b206574;
    state_ptr[3] = constant;

    // Words 4-11 are the key
    // Each word is a 4-byte/32-bit sub-key
    for i = 0 to 8 {
        word = sk_ptr[:u32 i];
        state_ptr[i + 4] = word;
    }

    return state_ptr;
}

fn chacha20_ietf_ivsetup(reg ptr u32[16] state_ptr, reg ptr u8[12] nonce_ptr) -> reg ptr u32[16]{
    reg u32 counter, word;
    inline int i;

    // Adding the counter to the state
    counter = 0;
    state_ptr[12] = counter;

    // Words 12-15 are the nonce
    for i = 0 to 3 {
        word = nonce_ptr[:u32 i];
        state_ptr[i + 13] = word;

    }

    return state_ptr;
}

fn chacha20_encrypt_bytes(reg ptr u32[16] state_ptr, reg u32 msg_ptr, reg u32 ct_ptr, reg u32 msg_len) -> reg ptr u32[16]{
    stack u8[64] keystream;
    reg ptr u8[64] keystream_ptr;
    reg u32 bytes_done, block_len, block_start, byte_index, byte, word, counter;
    inline int i;

    keystream_ptr = keystream;
    bytes_done = 0;

    while (bytes_done < msg_len) {
        // Generate 64 bytes of keystream from the current state
        keystream_ptr = chacha20_block(keystream_ptr, state_ptr);

        // Check whether on last block or not
        block_len = msg_len;
        block_len -= bytes_done;
        if (block_len > 64) {
            block_len = 64;
        }

        // Address in the output buffer where this block starts
        block_start = ct_ptr;
        block_start += bytes_done;

        // Full 64-byte block: copy 16 words of 4 bytes
        if (block_len == 64) {
            for i = 0 to 16 {
                word = keystream_ptr[:u32 i];
                [:u32 block_start + 4 * i] = word;
            }
        // Last, shorter block: copy byte by byte
        } else {
            byte_index = 0;
            while (byte_index < block_len) {
                byte = (32u)keystream_ptr[:u8 byte_index];
                [:u8 block_start + byte_index] = #STRB(byte);
                byte_index += 1;
            }
        }

        // Increase the block counter (word 12) for the next block
        counter = state_ptr[12];
        counter += 1;
        state_ptr[12] = counter;

        bytes_done += block_len;
    }

    return state_ptr;
}

// Export wrapper for quarterround
// dptr: pointer to 4 consecutive u32 values (a, b, c, d)
export fn test_quarterround(reg u32 dptr) {
    reg u32 a b c d;
    a = [dptr + 0];
    b = [dptr + 4];
    c = [dptr + 8];
    d = [dptr + 12];
    a, b, c, d = quarterround(a, b, c, d);
    [dptr + 0] = a;
    [dptr + 4] = b;
    [dptr + 8] = c;
    [dptr + 12] = d;
}

// Export wrapper for column_round
// state_ptr: pointer to 16-word (64-byte) state array
export fn test_column_round(reg ptr u32[16] state_ptr) -> reg ptr u32[16] {
    state_ptr = state_ptr;
    state_ptr = column_round(state_ptr);
    return state_ptr;
}

// Export wrapper for diagonal_round
// state_ptr: pointer to 16-word (64-byte) state array
export fn test_diagonal_round(reg ptr u32[16] state_ptr) -> reg ptr u32[16] {
    state_ptr = state_ptr;
    state_ptr = diagonal_round(state_ptr);
    return state_ptr;
}

// Export wrapper for double_round (for testing against a reference)
// state_ptr: pointer to 16-word (64-byte) state array; one double round in place
export fn test_double_round(reg ptr u32[16] state_ptr) -> reg ptr u32[16] {
    stack u32[4] c;
    reg u32 x0, x1, x2, x3, x4, x5, x6, x7, x12, x13, x14, x15;
    reg u32 t;
    inline int i;

    for i = 0 to 4 { t = state_ptr[8 + i]; c[i] = t; }
    x0  = state_ptr[0];  x1  = state_ptr[1];  x2  = state_ptr[2];  x3  = state_ptr[3];
    x4  = state_ptr[4];  x5  = state_ptr[5];  x6  = state_ptr[6];  x7  = state_ptr[7];
    x12 = state_ptr[12]; x13 = state_ptr[13]; x14 = state_ptr[14]; x15 = state_ptr[15];

    () = #spill(state_ptr);
    x0, x1, x2, x3, x4, x5, x6, x7, x12, x13, x14, x15, c =
        double_round(x0, x1, x2, x3, x4, x5, x6, x7, x12, x13, x14, x15, c);
    () = #unspill(state_ptr);

    state_ptr[0]  = x0;  state_ptr[1]  = x1;  state_ptr[2]  = x2;  state_ptr[3]  = x3;
    state_ptr[4]  = x4;  state_ptr[5]  = x5;  state_ptr[6]  = x6;  state_ptr[7]  = x7;
    for i = 0 to 4 { t = c[i]; state_ptr[8 + i] = t; }
    state_ptr[12] = x12; state_ptr[13] = x13; state_ptr[14] = x14; state_ptr[15] = x15;
    return state_ptr;
}

// Export wrapper for chacha20_block
// output_ptr: pointer to 64-byte output buffer
// input_ptr: pointer to 16-word (64-byte) input state array
export fn test_chacha20_block(reg ptr u8[64] output_ptr, reg ptr u32[16] input_ptr) -> reg ptr u8[64]{
    output_ptr = output_ptr;
    input_ptr = input_ptr;
    output_ptr = chacha20_block(output_ptr, input_ptr);
    return output_ptr;
}

// Export wrapper for chacha20_keysetup
// state_ptr: pointer to 16-word (64-byte) state array
// key_ptr: pointer to 32-byte key
export fn test_chacha20_keysetup(reg ptr u32[16] state_ptr, reg ptr u8[32] key_ptr) -> reg ptr u32[16] {
    state_ptr = state_ptr;
    key_ptr = key_ptr;
    state_ptr = chacha20_keysetup(state_ptr, key_ptr);
    return state_ptr;
}

// Export wrapper for chacha20_ietf_ivsetup
// state_ptr: pointer to 16-word (64-byte) state array
// nonce_ptr: pointer to 12-byte nonce
export fn test_chacha20_ietf_ivsetup(reg ptr u32[16] state_ptr, reg ptr u8[12] nonce_ptr) -> reg ptr u32[16] {
    state_ptr = state_ptr;
    nonce_ptr = nonce_ptr;
    state_ptr = chacha20_ietf_ivsetup(state_ptr, nonce_ptr);
    return state_ptr;
}

// Export wrapper for chacha20_encrypt_bytes
// state_ptr: pointer to 16-word (64-byte) state array
// msg_ptr: pointer to message (unused in current implementation)
// ct_ptr: pointer to output ciphertext/keystream buffer
// msg_len: length of message in bytes
export fn test_chacha20_encrypt_bytes(reg ptr u32[16] state_ptr, reg u32 msg_ptr, reg u32 ct_ptr, reg u32 msg_len) -> reg ptr u32[16] {
    state_ptr = state_ptr;
    msg_ptr = msg_ptr;
    ct_ptr = ct_ptr;
    msg_len = msg_len;
    state_ptr = chacha20_encrypt_bytes(state_ptr, msg_ptr, ct_ptr, msg_len);
    return state_ptr;
}

// Export wrapper for crypto_stream_chacha20_ietf (highest-level API)
// ct_ptr: pointer to output ciphertext/keystream buffer
// nonce_ptr: pointer to 12-byte nonce
// sk_ptr: pointer to 32-byte secret key
// ct_len: length of output in bytes
export fn crypto_stream_chacha20_ietf(reg u32 ct_ptr, reg ptr u8[12] nonce_ptr, reg ptr u8[32] sk_ptr, reg u32 ct_len){
    stack u32[16] state;
    reg ptr u32[16] state_ptr;
    reg u32 msg_ptr;

    state_ptr = state;
    state_ptr = chacha20_keysetup(state_ptr, sk_ptr);
    state_ptr = chacha20_ietf_ivsetup(state_ptr, nonce_ptr);

    msg_ptr = 0;
    state_ptr = chacha20_encrypt_bytes(state_ptr, msg_ptr, ct_ptr, ct_len);
}
